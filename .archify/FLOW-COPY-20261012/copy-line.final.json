  "cards": [
    {
      "dot": "cyan",
      "title": "输入校验（进场前）",
      "items": [
        "必有：topic 名称 + 内容方向 + 目标平台（Q-3 三类之一）",
        "缺字段不派单，退回运营人员补齐（R-L1-18）",
        "生成本次 prompt_version 并登记"
      ]
    },
    {
      "dot": "emerald",
      "title": "完成判据（交由下游前）",
      "items": [
        "文案：恰好 3 套，侧重点互不重复，各在平台字数区间内，每套附侧重点说明",
        "分镜：恰好 24 条，编号 1–24 连续，每条含场景 / 风格 / 时长 / 拍摄提示",
        "24 条整体风格一致、场景不重复"
      ]
    },
    {
      "dot": "amber",
      "title": "接口与依赖",
      "items": [
        "调用形态：generate_copy(brief, count=3) -> [draft]",
        "convert_to_storyboard(copy, grid='6x4') -> [shot]（R-L2-15）",
        "失败处理：模型失败按适配器降级链重试并记录（R-L2-17）",
        "skill 之间不互相调用，统一由编排者派单（S1 边界）"
      ]
    },
    {
      "dot": "rose",
      "title": "关口① 三态规则",
      "items": [
        "选择态：从 3 套里选 1 套，或要求重生成（带回退理由）",
        "重生成时把上一次的反馈一并交给 copy-writer",
        "选定结果写 hitl_events，未选定不得进入分镜环节"
      ]
    }
  ]
