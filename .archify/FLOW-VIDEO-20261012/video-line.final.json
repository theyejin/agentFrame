  "cards": [
    {
      "dot": "cyan",
      "title": "输入校验（进场前）",
      "items": [
        "必有：24 张独立图（编号齐全）+ 选定文案",
        "数量不足或编号断档 → 退回视觉线，不进入打包",
        "确认目标平台比例（横屏 16:9 / 竖屏 9:16）与时长上限"
      ]
    },
    {
      "dot": "emerald",
      "title": "完成判据（交由下游前）",
      "items": [
        "成片可播放，分辨率与平台要求一致，时长在平台上限内",
        "每个镜头能追溯到具体分镜编号与素材文件",
        "剪辑参数单与成片一一对应，可复现同一版本"
      ]
    },
    {
      "dot": "amber",
      "title": "关口② 调整态支持什么（§8.3）",
      "items": [
        "改顺序：拖拽镜头，实时预览",
        "改时长：单镜头时长与整体节奏",
        "换素材：替换某个镜头的图片或片段",
        "不满意可反复调整，直到点「确认导出」；全过程写 hitl_events"
      ]
    },
    {
      "dot": "rose",
      "title": "导出与兜底",
      "items": [
        "首选 Remotion 渲染；环境异常时 ffmpeg 兜底（Q-7）",
        "导出失败重试上限写进 skill README，超限转人工",
        "成片只落在本地，不自动上传任何平台（C-01）"
      ]
    }
  ]
