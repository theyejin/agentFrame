      "needs_key": false,
      "billable": false,
      "failure_signals": "MOCK_FAIL（测试用的人工失败标记）",
      "fallback_order": 1,
      "enabled": true,
      "note": "首版默认适配器：不需要密钥、不花钱，保证整条链路离线可跑（C-09）",
      "implemented": true,
      "cost_per_call": 0.0,
      "settings": {
        "runtime": "mock",
        "model": "mock-copy-v1"
      }
    },
