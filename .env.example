# .env.example — 环境变量样例（只放键名与说明，绝不放真实值；C-05）
# 用法：复制为 .env 后填入自己的值；.env 已在 .gitignore 中，不会入库。

# ---- 本地数据库 ----
# 本地 SQLite 文件路径（相对仓库根）；不入库（R-L1-04）
DB_PATH=db/app.db

# ---- 模型服务（通过 llm-adapter 统一调用，业务代码不直接引用服务名；R-L2-14）----
# 首版默认走免费额度（C-09 零付费门禁）；留空则使用离线假模型（tests/fixtures）
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# 单任务付费上限（元）；超限暂停并转人工（C-09）
LLM_COST_LIMIT=

# ---- 图像生成 / 图生视频（外部服务适配器层，可替换、可降级）----
IMAGE_PROVIDER=
IMAGE_API_KEY=
VIDEO_PROVIDER=
VIDEO_API_KEY=

# ---- 飞书文档（热点汇总与最终文档，Q-5：优先开放平台 API，失败导出文件）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_FOLDER_TOKEN=

# ---- 分发平台（只使用运营人员本人已登录的会话；不代持账号密码；C-08）----
# 浏览器调试端口：agent 连接到你自己登录好的浏览器，而不是新建会话
BROWSER_CDP_URL=http://127.0.0.1:9222

# ---- 运行参数 ----
# 日志目录（build-log 报告页数据源）
LOG_DIR=logs
# 运行期工作区（产物目录，不入库）
WORKSPACE_DIR=workspace
